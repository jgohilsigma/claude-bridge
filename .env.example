# Copy to ~/.claude-chat-bridge/.env (or run `bridge setup`, which creates it with mode 600).
# Environment variables with the same names override the file.

# Apps Script web app URL (Deploy → Manage deployments → Web app URL, ends with /exec)
BRIDGE_APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec

# Shared HMAC secret; must equal the SHARED_SECRET Script Property. `bridge setup` generates one.
BRIDGE_SHARED_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Google Workspace accounts allowed to answer (comma separated). Checked in Apps Script AND locally.
BRIDGE_ALLOWED_EMAILS=you@yourcompany.com

# Where questions are delivered — any combination, comma separated:
#   gmail     email via the Apps Script relay (also covers Google Chat; PUSH_MODE in Apps Script decides)
#   whatsapp  WhatsApp linked device on this PC (link once: node bin/bridge.js whatsapp login)
# All listed platforms get every question; the first answer from any of them wins.
BRIDGE_CHANNELS=gmail,whatsapp

# WhatsApp (optional). Empty = questions go to your own "Message yourself" chat.
# Set phone numbers (with country code) to have the linked account message them instead.
# Separate several numbers with commas: each gets every question and any of them can answer (first answer wins).
# BRIDGE_WHATSAPP_TO=919876543210,919812345678
# One WhatsApp group per session, named "Claude - <session name>", with the BRIDGE_WHATSAPP_TO numbers
# as members. Everything about a session (questions, finished/failed notices) goes to its group.
# BRIDGE_WHATSAPP_GROUPS=on
# Company networks that inspect HTTPS (e.g. Sophos) need their CA certificate for WhatsApp:
# BRIDGE_WHATSAPP_CA_FILE=/path/to/firewall-ca.pem
# Extra phone numbers allowed to answer (your own linked number is always allowed).
# BRIDGE_WHATSAPP_ALLOWED=

# Optional overrides
# BRIDGE_HOME=/path/to/state/dir            (default ~/.claude-chat-bridge)
# BRIDGE_QUESTION_TIMEOUT_SEC=1800
# BRIDGE_PUSH_DELAY_SEC=5                   (applies to every question kind)
# BRIDGE_LOCAL_PRESENCE_SEC=20
# BRIDGE_CLAUDE_COMMAND=claude
# BRIDGE_LOG_LEVEL=info
